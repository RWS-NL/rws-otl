utd:graaf-informatiemodel {
    utd-patroon:Bouwdeelgroep a sh:NodeShape ;
        sh:property [ sh:in ( utd:Elementgroep ) ;
                sh:message "Deze bouwdeelgroep moet een bovenliggende elementgroep hebben." ;
                sh:minCount 1 ;
                sh:path ( [ sh:inversePath nen2660:hasPart ] utd:subject ) ],
            [ sh:message "Deze bouwdeelgroep moet ten minste één lid bevatten." ;
                sh:minCount 1 ;
                sh:path skos:member ],
            [ sh:datatype xsd:string ;
                sh:message "De waarde is niet van het juiste type, het moet een xsd:string zijn." ;
                sh:nodeKind sh:Literal ;
                sh:path utd:RWSconcept ],
            [ sh:message "Waarde ontbreekt." ;
                sh:minCount 1 ;
                sh:path utd:RWSconcept ] ;
        sh:target [ a sh:SPARQLTarget ;
                sh:select """SELECT ?this WHERE {
                    ?this <https://data.rws.nl/def/utd/subject> <https://data.rws.nl/def/utd/Bouwdeelgroep>
                }""" ] .

    utd-patroon:Elementgroep a sh:NodeShape ;
        sh:property [ sh:message "Deze Elementgroep heeft geen bovenliggend beheerobject." ;
                sh:minCount 1 ;
                sh:path [ sh:inversePath nen2660:hasPart ] ],
            [ sh:message "Deze elementgroep moet ten minste één lid bevatten." ;
                sh:minCount 1 ;
                sh:path skos:member ],
            [ sh:in ( utd:Bouwdeelgroep ) ;
                sh:message "Deze Elementgroep voldoet niet aan de typische decompositie, het bevat een incorrect onderliggend concept." ;
                sh:path ( nen2660:hasPart utd:subject ) ],
            [ sh:message "Deze Elementgroep voldoet niet aan de typische decompositie, het bevat geen onderliggende bouwdeelgroep." ;
                sh:minCount 1 ;
                sh:path ( nen2660:hasPart utd:subject ) ],
            [ sh:path nen2660:hasPart ;
                sh:property [ sh:message "Deze bouwdeelgroep heeft geen UTD-typering" ;
                        sh:minCount 1 ;
                        sh:path utd:subject ] ],
